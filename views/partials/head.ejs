<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title><%= (typeof title !== 'undefined' && title) ? title + ' · ' + siteName : siteName %></title>
  <meta name="description" content="Sonorus - self-hosted music player for your own audio files." />
  <meta name="robots" content="noindex" />
  <%# The mark is a level meter: the same four bars the app uses to show what is playing %>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%23f5a524'/%3E%3Cg fill='%2324170a'%3E%3Crect x='3.5' y='9' width='2.6' height='6' rx='1.3'/%3E%3Crect x='8.6' y='4' width='2.6' height='16' rx='1.3'/%3E%3Crect x='13.7' y='7' width='2.6' height='10' rx='1.3'/%3E%3Crect x='18.8' y='10.4' width='2.6' height='3.2' rx='1.3'/%3E%3C/g%3E%3C/svg%3E" />
  <link rel="manifest" href="/static/manifest.webmanifest" />
  <meta name="theme-color" content="#100e14" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="<%= siteName %>" />
  <%# Applies the saved theme before paint; external file, so the CSP can forbid inline scripts %>
  <script src="/static/js/theme-init.js?v=<%= assetVersion %>"></script>
  <link rel="stylesheet" href="/static/css/styles.css?v=<%= assetVersion %>" />
</head>
