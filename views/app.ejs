<%- include('partials/head') %>
<body class="app">
<div class="shell">

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-head">
      <%- include('partials/brand') %>
      <span class="brand-name"><%= siteName %></span>
      <!-- Folds the sidebar away on a desktop and brings it back. Folded, the
           sidebar is a narrow rail rather than nothing, so the mark stays put
           and this button stays with it - which is why there is no second one
           anywhere else. On a phone the sidebar is a drawer and the hamburger
           already does that job, so this one is hidden there. -->
      <button type="button" class="icon-btn icon-btn-sm sidebar-toggle" id="sidebar-collapse"
              aria-label="Seitenleiste einklappen" title="Seitenleiste einklappen"
              aria-expanded="true" data-icon="panel-left" data-icon-size="17"></button>
    </div>
    <div class="sidebar-scroll" id="sidebar-nav"></div>
  </aside>
  <!-- Only visible while the sidebar is a drawer over the content: tapping next
       to it is how it gets closed again. -->
  <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

  <div class="main">
    <header class="topbar">
      <button type="button" class="icon-btn menu-toggle" id="menu-toggle" aria-label="Menü" data-icon="menu"></button>
      <div class="nav-arrows">
        <button type="button" class="icon-btn" id="nav-back" aria-label="Zurück" data-icon="chevron-left"></button>
        <button type="button" class="icon-btn" id="nav-forward" aria-label="Vorwärts" data-icon="chevron-right"></button>
      </div>
      <form class="search" id="search-form" role="search">
        <span class="search-icon" data-icon="search" aria-hidden="true"></span>
        <input type="search" id="search-input" name="q" placeholder="Titel, Interpret, Album" aria-label="Bibliothek durchsuchen" />
      </form>
      <div class="topbar-right">
        <!-- The two pages that are about the app rather than about the music.
             They sit next to the avatar instead of at the bottom of the library
             list; below 560 px they give way and the account menu carries them.
             The labels are filled in by app.js, which also hangs the count of
             open import notices on the settings link. -->
        <a href="/stats" class="top-link" id="top-stats" data-link title="Statistik"></a>
        <a href="/settings" class="top-link icon-only" id="top-settings" data-link title="Einstellungen"></a>
        <div class="menu-wrap" id="user-menu">
          <button type="button" class="avatar-btn" id="avatar-btn" aria-haspopup="true" aria-expanded="false" aria-label="Konto-Menü">
            <span class="avatar avatar-sm" id="topbar-avatar"></span>
          </button>
          <div class="dropdown" id="user-dropdown" role="menu" hidden></div>
        </div>
      </div>
    </header>

    <main class="content" id="content">
      <div class="loading">Bibliothek wird geladen …</div>
    </main>

    <!-- The big view: what is playing, taking the whole content area but not
         the sidebar and not the topbar - the library stays one click away.
         Three tabs over one player: the song itself, its text, and the
         visualizer that used to cover the entire screen on its own. It sits
         next to the content instead of over it, so nothing has to be stacked
         and the page underneath keeps its scroll position. -->
    <section class="bigview" id="bigview" hidden aria-label="Vollbild">
      <div class="bigview-head">
        <div class="bigview-tabs" role="tablist" aria-label="Ansicht">
          <button type="button" class="bigview-tab" role="tab" data-bigtab="player">Player</button>
          <button type="button" class="bigview-tab" role="tab" data-bigtab="lyrics">Songtext</button>
          <button type="button" class="bigview-tab" role="tab" data-bigtab="visual">Visualisierung</button>
        </div>
        <!-- Only on the Songtext tab, and only for a text that is timed at
             all: there is nothing to shift in a lyric that carries no seconds. -->
        <button type="button" class="icon-btn offset-toggle" id="bigview-offset" hidden
                aria-label="Songtext versetzen" title="Songtext versetzen"
                aria-pressed="false" data-icon="timing" data-icon-size="18"></button>
        <button type="button" class="icon-btn" id="bigview-close" aria-label="Vollbild schließen"
                title="Vollbild schließen" data-icon="minimize" data-icon-size="18"></button>
      </div>
      <div class="bigview-body">
        <div class="bigview-pane pane-player" data-pane="player">
          <div class="bigview-art" id="bigview-art"></div>
          <div class="bigview-meta">
            <h1 class="bigview-title" id="bigview-title">Nichts ausgewählt</h1>
            <p class="bigview-sub" id="bigview-sub">Wähle einen Titel aus der Bibliothek</p>
            <!-- The line being sung, when the song brings a timed text with it. -->
            <p class="bigview-line" id="bigview-line"></p>
          </div>
        </div>
        <div class="bigview-pane pane-lyrics" data-pane="lyrics" hidden>
          <div class="lyrics-body" id="bigview-lyrics"></div>
        </div>
        <div class="bigview-pane pane-visual" data-pane="visual" hidden>
          <canvas id="bigview-canvas"></canvas>
        </div>
      </div>
    </section>
  </div>

  <footer class="player">
    <button type="button" class="seek-rail" id="seek" aria-label="Position im Titel"
            role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0:00">
      <span class="seek-track">
        <span class="seek-buffer" id="seek-buffer"></span>
        <span class="seek-fill" id="seek-fill"></span>
        <span class="seek-knob" id="seek-knob"></span>
      </span>
    </button>

    <!-- Only the fullscreen player on a phone shows this row; the bar has no
         room for it and hides it. -->
    <div class="now-head">
      <button type="button" class="icon-btn now-collapse" id="now-collapse" aria-label="Vollbild schließen" data-icon="chevron-down"></button>
      <span class="rack-label now-source" id="now-source"></span>
    </div>

    <div class="now">
      <button type="button" class="now-art" id="now-art" aria-label="Album öffnen"></button>
      <!-- The line being sung right now. Only the full screen on a phone has
           room for it, so the bar hides it - see .now-line in the stylesheet.
           A button, because tapping the line is the shortest way to the rest
           of the text. -->
      <button type="button" class="now-line" id="now-line" aria-label="Songtext öffnen"></button>
      <div class="now-text">
        <!-- data-clip: says its full name on hover, but only when it really had
             to be cut off - see the truncation handler in app.js. -->
        <!-- The way into the big view on a desktop; on a phone the tap belongs
             to the sheet that blows the whole transport up. -->
        <span class="now-title" id="now-title" data-clip role="button" tabindex="0">Nichts ausgewählt</span>
        <span class="now-artist" id="now-artist">Wähle einen Titel aus der Bibliothek</span>
        <div class="now-actions">
          <div class="stars" id="now-stars" role="group" aria-label="Bewertung"></div>
          <button type="button" class="icon-btn now-add" id="now-add" hidden
                  aria-label="Zu Playlist hinzufügen" title="Zu Playlist hinzufügen"
                  data-icon="plus" data-icon-size="15"></button>
        </div>
      </div>
    </div>

    <div class="transport">
      <div class="transport-buttons">
        <button type="button" class="icon-btn" id="btn-shuffle" aria-label="Zufallswiedergabe" aria-pressed="false" data-icon="shuffle"></button>
        <button type="button" class="icon-btn" id="btn-prev" aria-label="Vorheriger Titel" data-icon="skip-back"></button>
        <button type="button" class="play-btn" id="btn-play" aria-label="Wiedergabe" data-icon="play"></button>
        <button type="button" class="icon-btn" id="btn-next" aria-label="Nächster Titel" data-icon="skip-forward"></button>
        <button type="button" class="icon-btn" id="btn-repeat" aria-label="Wiederholen: aus" data-icon="repeat"></button>
      </div>
      <div class="counter">
        <span class="elapsed num" id="time-elapsed">0:00</span>
        <span class="sep">/</span>
        <span class="num" id="time-total">0:00</span>
      </div>
    </div>

    <div class="player-right">
      <canvas class="meter" id="meter" width="144" height="52" aria-hidden="true"></canvas>
      <button type="button" class="icon-btn" id="btn-visualizer" aria-label="Vollbild" title="Vollbild" data-icon="maximize"></button>
      <div class="volume">
        <button type="button" class="icon-btn" id="btn-mute" aria-label="Stumm schalten" data-icon="volume-high"></button>
        <input type="range" class="volume-slider" id="volume" min="0" max="100" value="100" aria-label="Lautstärke" />
      </div>
      <button type="button" class="icon-btn" id="btn-lyrics" aria-label="Songtext" aria-pressed="false" data-icon="lyrics"></button>
      <button type="button" class="icon-btn" id="btn-queue" aria-label="Wiedergabeliste" data-icon="queue"></button>
    </div>
  </footer>

  <aside class="queue" id="queue" aria-label="Aktuelle Wiedergabeliste">
    <div class="queue-head">
      <div>
        <span class="rack-label">Wiedergabe</span>
        <h2 id="queue-source">Warteschlange</h2>
      </div>
      <button type="button" class="icon-btn" id="queue-close" aria-label="Schließen" data-icon="x"></button>
    </div>
    <div class="queue-list" id="queue-list"></div>
  </aside>

  <!-- The lyrics of what is playing. Built like the queue panel on purpose: it
       is the same kind of thing - a side panel about the current track - so it
       gets the same slide-in, the same width and the same way out. -->
  <aside class="queue lyrics-panel" id="lyrics" aria-label="Songtext">
    <div class="queue-head">
      <div>
        <span class="rack-label">Songtext</span>
        <h2 id="lyrics-title">Nichts ausgewählt</h2>
      </div>
      <button type="button" class="icon-btn offset-toggle" id="lyrics-offset-toggle" hidden
              aria-label="Songtext versetzen" title="Songtext versetzen"
              aria-pressed="false" data-icon="timing"></button>
      <button type="button" class="icon-btn" id="lyrics-close" aria-label="Schließen" data-icon="x"></button>
    </div>
    <div class="lyrics-body" id="lyrics-body"></div>
  </aside>

  <!-- Moving a song's text against the song. An overlay and deliberately not a
       dialog: it has no backdrop and it takes nothing away, so the lines keep
       running behind it while the number changes - which is the only way to
       tell whether the number is right. Saved per song on the server, so the
       correction holds on every client and every next time. -->
  <div class="lyric-offset" id="lyric-offset" hidden role="group" aria-label="Songtext versetzen">
    <div class="lyric-offset-head">
      <span class="rack-label">Versatz</span>
      <button type="button" class="icon-btn icon-btn-sm" id="lyric-offset-close"
              aria-label="Schließen" data-icon="x" data-icon-size="14"></button>
    </div>
    <div class="lyric-offset-set">
      <button type="button" class="icon-btn" id="lyric-offset-earlier"
              aria-label="Eine Zehntelsekunde früher" title="Früher"
              data-icon="minus" data-icon-size="16"></button>
      <span class="lyric-offset-value num" id="lyric-offset-value">0,0 s</span>
      <button type="button" class="icon-btn" id="lyric-offset-later"
              aria-label="Eine Zehntelsekunde später" title="Später"
              data-icon="plus" data-icon-size="16"></button>
    </div>
    <input type="range" class="lyric-offset-range" id="lyric-offset-range"
           min="-5" max="5" step="0.1" value="0" aria-label="Versatz in Sekunden" />
    <!-- The two ends of the slider named where they are, with the way back to
         nothing between them. -->
    <div class="lyric-offset-foot">
      <span class="lyric-offset-hint">früher</span>
      <button type="button" class="lyric-offset-reset" id="lyric-offset-reset">Zurücksetzen</button>
      <span class="lyric-offset-hint">später</span>
    </div>
  </div>
</div>

<audio id="audio" preload="metadata"></audio>
<div class="toasts" id="toasts" aria-live="polite"></div>
<div id="modal-root"></div>

<script type="module" src="/static/js/app.js?v=<%= assetVersion %>"></script>
</body>
</html>
