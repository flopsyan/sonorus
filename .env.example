# Sonorus configuration.
# Copy this file to ".env" and adjust the values.

# --- Music library -----------------------------------------------------------
# Host path of your music folder. It is mounted READ-ONLY into the container -
# Sonorus only reads tags and cover art, it never writes to your files.
MUSIC_DIR=./music

# --- Podcasts ----------------------------------------------------------------
# Host path of your podcast folder, one subfolder per show and the episodes in
# it. Mounted READ-ONLY like the music. May be left as is or point at nothing -
# an instance without spoken word simply has nothing to scan there.
#
# It must NOT lie inside MUSIC_DIR: a file found under both roots would be read
# once as a song and once as an episode, and whichever came last would win.
PODCAST_DIR=./podcasts

# --- Audiobooks --------------------------------------------------------------
# Host path of your audiobook folder, one folder per author and one folder per
# book inside it; the files in a book folder are its parts and are never shown.
# Mounted READ-ONLY, may point at nothing, and must not lie inside MUSIC_DIR.
AUDIOBOOK_DIR=./audiobooks

# --- Radio plays -------------------------------------------------------------
# Host path of your radio-play folder, laid out exactly like the audiobooks: one
# folder per author and one folder per play inside it. Kept apart from the books
# because it is a library of its own to listen to - a play has a cast where a
# book has a narrator, and Sonorus shows the two as separate tabs.
# Mounted READ-ONLY, may point at nothing, and must not lie inside MUSIC_DIR.
AUDIODRAMA_DIR=./audiodramas

# --- eBooks ------------------------------------------------------------------
# Host path of your ebook folder, laid out like the audiobooks: one folder per
# author and one folder per book inside it, holding the EPUB. Only .epub is
# read. Mounted READ-ONLY, may point at nothing, and must not lie inside
# MUSIC_DIR.
EBOOK_DIR=./ebooks

# When to scan the library on start:
#   auto   - only when the library is still empty (default)
#   always - on every container start
#   never  - never; scan manually under Einstellungen
SCAN_ON_START=auto

# --- Server ------------------------------------------------------------------
# Host port the app is reachable on (http://localhost:PORT)
PORT=3000

# Name shown in the header and the browser tab
SITE_NAME=Sonorus

# Reverse proxies in front of the app (Express "trust proxy"). 1 (default) =
# one reverse proxy: the client IP for the login rate limit is taken from
# X-Forwarded-For as set by that proxy. Set to false when the app is exposed
# directly, so clients cannot spoof their IP via that header.
TRUST_PROXY=1

# --- Login / accounts --------------------------------------------------------
# Sonorus requires a login for everything (no public access). On the very first
# start, if no account exists yet, open the app in the browser and you will be
# guided through a one-time setup page to create the first admin account.
#
# Alternatively, bootstrap that first admin non-interactively by setting a
# password here (useful for automated deployments). Once an account exists, the
# env values no longer override anything; manage accounts in the UI under
# Einstellungen. Only admins can manage accounts; all other rights are shared
# equally by every account.
AUTH_USER=admin
AUTH_PASSWORD=

# Optional: secret for signing session cookies. If empty, a random one is
# generated and stored in the database (stable across restarts; rotating it
# logs everyone out).
# AUTH_SECRET=

# --- Quality -----------------------------------------------------------------
# Sonorus can serve a smaller copy of a song instead of the original file, which
# is what the "Qualität" setting picks on each device. The copies are made with
# ffmpeg, kept on disk and re-used; an instance without ffmpeg simply has one
# quality instead of two and says so under Einstellungen.
#
# How large the cache of those copies may grow, in GB, before the least recently
# used entries are dropped. This is an eviction threshold, not a budget: nothing
# is refused for being over it, the oldest copies are deleted. The whole library
# re-encoded is ungefähr a third of the size of the FLACs it was made from.
#
# **0 turns the limit off** and nothing is ever evicted - which is what you want
# when the cache sits on a volume with room to spare and you would rather keep
# every copy than re-encode it on the next long drive.
TRANSCODE_MAX_GB=60

# Only relevant when running without Docker (npm start):
# storage location of the SQLite database and the extracted cover art, and of
# the re-encoded copies (which default to a folder inside DATA_DIR).
# DATA_DIR=./data
# TRANSCODE_DIR=./data/transcodes
# Path to the ffmpeg binary, if it is not simply on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
